{
  "name": "react-router-auto-routes",
  "version": "1.0.0",
  "description": "Automatic folder-based routing with colocation for React Router v7+",
  "keywords": [
    "colocation",
    "file-based",
    "flat-routes",
    "flexible",
    "react-router",
    "routes",
    "routing"
  ],
  "license": "MIT",
  "author": {
    "name": "Kenn Ejima",
    "email": "kenn@users.noreply.github.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kenn/react-router-auto-routes.git"
  },
  "bin": {
    "migrate-auto-routes": "dist/cli.cjs"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "test": "NODE_OPTIONS=\"--no-warnings=DEP0040\" vitest",
    "typecheck": "tsc -b",
    "prepublishOnly": "npm run typecheck && npm run build && npm run test -- --run",
    "np": "np"
  },
  "dependencies": {
    "oxc-parser": "^0.146.0",
    "picomatch": "^4.0.5"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/picomatch": "^4.0.3",
    "np": "^12.0.1",
    "oxfmt": "^0.64.0",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "packageManager": "pnpm@11.23.0+sha512.f00082e5b283a199b74e079da28d155c008fe232f44c8a06ea7ddfa014ecf719fc362f790ecc67b28106ddac2afb24c49a9a079159da560b2ce7d1e98efd11af"
}
